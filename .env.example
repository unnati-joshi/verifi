# --- Server ---
NODE_ENV=development
PORT=3000
# Public URL of the app, no trailing slash. Must match the Google OAuth redirect URI.
APP_URL=http://localhost:3000
# Number of reverse proxies in front of the app (1 for Render/Railway/Nginx).
TRUST_PROXY=1

# --- Database ---
# SQLite file; created on first start. Put it on a persistent disk in production.
DB_PATH=./data/verifi.db

# --- Auth ---
# Required in production (32+ chars):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Google OAuth 2.0 (optional; the Google button is hidden when empty) ---
# Authorized redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
